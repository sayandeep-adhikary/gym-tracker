rules_version = '2';

// Firestore security rules for Gym Tracker.
// Each authenticated user can read and write only their own document at
// `users/{uid}`. Copy these into Firebase Console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
